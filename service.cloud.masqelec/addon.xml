<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.cloud.masqelec"
       name="Cloud masQelec"
       version="2.1.4"
       provider-name="Cloud masQelec">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">Cloud masQelec te mantiene actualizado.</summary>
        <summary lang="en_GB">Cloud masQelec keeps you updated.</summary>
        <description lang="es_ES">Addon de servicio para Kodi que te mantiene actualizado, permite activar actualizaciones automáticas, actualizar bibliotecas y canales de TV.</description>
        <description lang="en_GB">The service addon for Kodi keeps you updated, allows you to enable automatic updates, and to update libraries and TV channels.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>

